# syntax=docker/dockerfile:1.7
# One-shot DB migrate (+ optional seed via command override).
FROM node:22-bookworm-slim AS base
WORKDIR /app
RUN corepack enable && apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

FROM base AS deps
ENV HUSKY=0
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn ./.yarn
COPY apps/api/package.json ./apps/api/
COPY apps/ayni-worker/package.json ./apps/ayni-worker/
COPY apps/web/package.json ./apps/web/
COPY packages/database/package.json ./packages/database/
COPY packages/domain/package.json ./packages/domain/
COPY packages/shared-schemas/package.json ./packages/shared-schemas/
COPY packages/zero-dev/package.json ./packages/zero-dev/
COPY packages/contracts/package.json ./packages/contracts/
RUN yarn install --immutable

FROM base AS runner
ENV NODE_ENV=production
COPY --from=deps /app /app
COPY packages/database ./packages/database
CMD ["yarn", "workspace", "@alpacto/database", "migrate"]
