# Copy to infra/docker/.env (or keep secrets in repo-root .env).
# On a VPS, set PUBLIC hostnames/IPs so browsers can reach API + MinIO.

# --- Public URLs (browser) ---
APP_URL=http://YOUR_VPS_IP:3000
API_URL=http://YOUR_VPS_IP:4000
NEXT_PUBLIC_API_URL=http://YOUR_VPS_IP:4000
S3_PUBLIC_ENDPOINT=http://YOUR_VPS_IP:9000
# Origins allowed for browser evidence PUT (MinIO global CORS). Comma-separated, no spaces.
# Example VPS: S3_CORS_ORIGINS=https://alpacto.arroz.dev,http://localhost:3000
# Empty = * (all origins, fine for public demo).
S3_CORS_ORIGINS=

# --- Host ports (local dev / IP:port access) ---
# Dokploy with domains: use docker-compose.dokploy.yml (no host bind) OR set free ports (WEB_PORT=3002).
WEB_PORT=3000
API_PORT=4000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Internal service URLs (containers) ---
DATABASE_URL=postgresql://alpacto:alpacto@postgres:5432/alpacto
REDIS_URL=redis://redis:6379
S3_ENDPOINT=http://minio:9000
S3_BUCKET=alpacto-evidence
S3_ACCESS_KEY=alpacto
S3_SECRET_KEY=alpacto123
S3_REGION=us-east-1

POSTGRES_USER=alpacto
POSTGRES_PASSWORD=alpacto
POSTGRES_DB=alpacto

JWT_SECRET=change-me-on-vps

# --- Chain / ZeroDev / AI (required for full demo) ---
CHAIN_ID=421614
ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ALPACTO_CONTRACT_ADDRESS=
USDC_TOKEN_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
TREASURY_PRIVATE_KEY=

ZERODEV_PROJECT_ID=
ZERODEV_BUNDLER_RPC=
ZERODEV_PAYMASTER_RPC=
NEXT_PUBLIC_ZERODEV_PROJECT_ID=

AYNI_SESSION_KEY=
AYNI_SMART_ACCOUNT=
AYNI_SERIALIZED_SESSION=
AYNI_USE_FIXTURE_VISION=true

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-luna

STRIPE_SECRET_KEY=
# MVP Docker: leave empty — compose auto-loads whsec from `stripe listen --print-secret`
# and the `stripe` service forwards to http://api:4000/webhooks/stripe (Docker DNS).
# Production Dashboard endpoint: paste Dashboard signing secret + set STRIPE_USE_CLI=0
STRIPE_WEBHOOK_SECRET=
STRIPE_USE_CLI=1
STRIPE_PRICE_MODE=demo

DEMO_MAX_FUNDING_USDC=10000
# Leave empty (or omit) to use alpacto-local-demo-wallet-seed-v1 — same Kernel wallets as local.
# Only set a different value if you intentionally want a separate VPS wallet set.
DEMO_WALLET_SEED=
DEMO_BUYER_SMART_ACCOUNT=
DEMO_ASSOCIATION_SMART_ACCOUNT=
DEMO_LOCAL_PAYOUT_ENABLED=true

# Admin panel: require this password to revoke Ayni session keys (public demo safety).
ADMIN_AYNI_REVOKE_PASSWORD=

# Buyer funding: require this password before Stripe Checkout (protects demo Sepolia USDC).
DEMO_FUNDING_PASSWORD=

# First-boot auto seed+wallets (0=run when DB empty / wallets missing)
SKIP_BOOTSTRAP=0
