# syntax=docker/dockerfile:1.7
# Ayni audit worker — BullMQ consumer via tsx.
FROM node:22-bookworm-slim AS base
WORKDIR /app
RUN corepack enable && apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

FROM base AS deps
ENV HUSKY=0
COPY package.json yarn.lock .yarnrc.yml ./
COPY .yarn ./.yarn
COPY apps/api/package.json ./apps/api/
COPY apps/ayni-worker/package.json ./apps/ayni-worker/
COPY apps/web/package.json ./apps/web/
COPY packages/database/package.json ./packages/database/
COPY packages/domain/package.json ./packages/domain/
COPY packages/shared-schemas/package.json ./packages/shared-schemas/
COPY packages/zero-dev/package.json ./packages/zero-dev/
COPY packages/contracts/package.json ./packages/contracts/
COPY packages/config/package.json ./packages/config/
COPY packages/contract-abi/package.json ./packages/contract-abi/
COPY packages/contract-client/package.json ./packages/contract-client/
COPY packages/ui/package.json ./packages/ui/
RUN yarn install --immutable

FROM base AS runner
ENV NODE_ENV=production
COPY --from=deps /app /app
COPY apps/ayni-worker ./apps/ayni-worker
COPY packages/database ./packages/database
COPY packages/domain ./packages/domain
COPY packages/shared-schemas ./packages/shared-schemas
COPY packages/zero-dev ./packages/zero-dev

CMD ["yarn", "workspace", "@alpacto/ayni-worker", "exec", "tsx", "src/worker.ts"]
