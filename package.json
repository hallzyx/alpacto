{
  "name": "alpacto",
  "version": "0.1.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "scripts": {
    "account": "yarn workspace @alpacto/contracts account",
    "chain": "./nitro-devnode/start-chain-with-cors.sh",
    "clean-contracts": "yarn workspace @alpacto/contracts clean-contracts",
    "compile": "yarn workspace @alpacto/contracts compile",
    "deploy": "yarn workspace @alpacto/contracts deploy",
    "export-abi": "yarn workspace @alpacto/contracts export-abi",
    "flatten": "yarn workspace @alpacto/contracts flatten",
    "fork": "yarn workspace @alpacto/contracts fork",
    "format": "yarn web:format",
    "generate": "yarn workspace @alpacto/contracts generate",
    "info:networks": "yarn workspace @alpacto/contracts info:networks",
    "postinstall": "husky install",
    "new-module": "yarn workspace @alpacto/contracts new-module",
    "web:build": "yarn workspace @alpacto/web build",
    "web:check-types": "yarn workspace @alpacto/web check-types",
    "web:format": "yarn workspace @alpacto/web format",
    "web:lint": "yarn workspace @alpacto/web lint",
    "precommit": "lint-staged",
    "start": "yarn workspace @alpacto/web dev",
    "stylus-verify": "yarn workspace @alpacto/contracts stylus-verify",
    "stylus:format": "yarn workspace @alpacto/contracts format",
    "stylus:lint": "yarn workspace @alpacto/contracts lint",
    "stylus:test": "yarn workspace @alpacto/contracts test",
    "phase1": "yarn workspace @alpacto/contracts phase1",
    "phase2": "yarn workspace @alpacto/api phase2",
    "phase3": "yarn workspace @alpacto/zero-dev phase3",
    "ayni:session": "yarn workspace @alpacto/zero-dev ayni:session",
    "phase4": "yarn workspace @alpacto/api phase4",
    "ayni:dev": "yarn workspace @alpacto/ayni-worker dev",
    "phase5": "yarn workspace @alpacto/ayni-worker phase5",
    "phase6": "yarn workspace @alpacto/api phase6",
    "web:dev": "yarn workspace @alpacto/web dev",
    "docker:up": "yarn docker:ensure-env && docker compose -f infra/docker/docker-compose.yml --env-file infra/docker/.env up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml --env-file infra/docker/.env down",
    "docker:build": "yarn docker:ensure-env && docker compose -f infra/docker/docker-compose.yml --env-file infra/docker/.env build",
    "docker:stack": "yarn docker:ensure-env && docker compose -f infra/docker/docker-compose.yml --env-file infra/docker/.env up -d --build",
    "docker:logs": "docker compose -f infra/docker/docker-compose.yml logs -f api web ayni",
    "docker:seed": "yarn docker:ensure-env && docker compose -f infra/docker/docker-compose.yml --env-file infra/docker/.env --profile seed up seed",
    "docker:ensure-env": "node -e \"const fs=require('fs');const p='infra/docker/.env';if(!fs.existsSync(p)){fs.copyFileSync('infra/docker/.env.example',p);console.log('created '+p+' from example');}\"",
    "db:generate": "yarn workspace @alpacto/database generate",
    "db:migrate": "yarn workspace @alpacto/database migrate",
    "db:seed": "yarn workspace @alpacto/database seed",
    "db:seed:reset-tx": "yarn workspace @alpacto/database seed:reset-tx",
    "seed:wallets": "yarn workspace @alpacto/zero-dev seed:wallets",
    "fund-demo-buyer": "yarn workspace @alpacto/zero-dev fund-demo-buyer",
    "settle-demo-lot": "yarn workspace @alpacto/api settle-demo-lot",
    "set-platform-treasury": "yarn workspace @alpacto/api set-platform-treasury",
    "api:dev": "yarn workspace @alpacto/api dev",
    "api:test": "yarn workspace @alpacto/api test",
    "domain:test": "yarn workspace @alpacto/domain test",
    "test": "yarn domain:test && yarn api:test && yarn stylus:test",
    "vercel": "yarn workspace @alpacto/web vercel",
    "vercel:yolo": "yarn workspace @alpacto/web vercel:yolo",
    "verify": "yarn workspace @alpacto/contracts verify"
  },
  "devDependencies": {
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3"
  },
  "packageManager": "yarn@3.2.3"
}
