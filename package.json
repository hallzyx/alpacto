{
  "name": "alpacto",
  "version": "0.1.0",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ]
  },
  "scripts": {
    "account": "yarn workspace @alpacto/contracts account",
    "chain": "./nitro-devnode/start-chain-with-cors.sh",
    "clean-contracts": "yarn workspace @alpacto/contracts clean-contracts",
    "compile": "yarn workspace @alpacto/contracts compile",
    "deploy": "yarn workspace @alpacto/contracts deploy",
    "export-abi": "yarn workspace @alpacto/contracts export-abi",
    "flatten": "yarn workspace @alpacto/contracts flatten",
    "fork": "yarn workspace @alpacto/contracts fork",
    "format": "yarn web:format",
    "generate": "yarn workspace @alpacto/contracts generate",
    "info:networks": "yarn workspace @alpacto/contracts info:networks",
    "postinstall": "husky install",
    "new-module": "yarn workspace @alpacto/contracts new-module",
    "web:build": "yarn workspace @alpacto/web build",
    "web:check-types": "yarn workspace @alpacto/web check-types",
    "web:format": "yarn workspace @alpacto/web format",
    "web:lint": "yarn workspace @alpacto/web lint",
    "precommit": "lint-staged",
    "start": "yarn workspace @alpacto/web dev",
    "stylus-verify": "yarn workspace @alpacto/contracts stylus-verify",
    "stylus:format": "yarn workspace @alpacto/contracts format",
    "stylus:lint": "yarn workspace @alpacto/contracts lint",
    "stylus:test": "yarn workspace @alpacto/contracts test",
    "phase1": "yarn workspace @alpacto/contracts phase1",
    "test": "yarn stylus:test",
    "vercel": "yarn workspace @alpacto/web vercel",
    "vercel:yolo": "yarn workspace @alpacto/web vercel:yolo",
    "verify": "yarn workspace @alpacto/contracts verify"
  },
  "devDependencies": {
    "husky": "^8.0.1",
    "lint-staged": "^13.0.3"
  },
  "packageManager": "yarn@3.2.3"
}
