# App
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000

# Web (apps/web) — also copy to apps/web/.env.local
NEXT_PUBLIC_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_ZERODEV_PROJECT_ID=

# Database
DATABASE_URL=postgresql://alpacto:alpacto@localhost:5432/alpacto
REDIS_URL=redis://localhost:6379
JWT_SECRET=alpacto-demo-jwt-secret-change-me

# Storage
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=alpacto-evidence
S3_ACCESS_KEY=alpacto
S3_SECRET_KEY=alpacto123

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MODE=demo

# Chain (Arbitrum Sepolia = 421614)
CHAIN_ID=421614
ARBITRUM_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ALPACTO_CONTRACT_ADDRESS=
USDC_TOKEN_ADDRESS=0x75faf114eafb1BDbe2F0316DF893fd58CE46AA4d
TREASURY_PRIVATE_KEY=

# ZeroDev (dashboard.zerodev.app — enable Gas Policy for Arbitrum Sepolia)
ZERODEV_PROJECT_ID=
ZERODEV_BUNDLER_RPC=
ZERODEV_PAYMASTER_RPC=
AYNI_SESSION_KEY=
AYNI_SMART_ACCOUNT=
AYNI_SERIALIZED_SESSION=
# Regenerate trio (session key + smart account + serialized): yarn ayni:session
# true = use repo fixtures for vision (yarn phase5); false = call OpenAI gpt-5.6-luna
AYNI_USE_FIXTURE_VISION=true

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# OpenAI
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-luna

# Demo
DEMO_MAX_FUNDING_USDC=10000
# Deterministic seed for yarn seed:wallets (Kernel ECDSA on Arbitrum Sepolia)
DEMO_WALLET_SEED=change-me-alpacto-demo-wallets-v1
# Filled by yarn seed:wallets (also written to users.smart_account_address)
DEMO_BUYER_SMART_ACCOUNT=
DEMO_ASSOCIATION_SMART_ACCOUNT=
DEMO_PEN_PER_USDC_MICROS=
DEMO_LOCAL_PAYOUT_ENABLED=true
